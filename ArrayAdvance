public static ArrayList<ArrayList<Integer>> pos(int []arr){
        ArrayList<ArrayList<Integer>> result=new ArrayList<>();
        result.add(new ArrayList<>());
        for(int i:arr){
            int n=result.size();
            for(int j=0;j<n;j++){
                ArrayList<Integer> inner=new ArrayList<>(result.get(j));
                inner.add(i);
                result.add(inner);
            }
        }
        return result;
    }
